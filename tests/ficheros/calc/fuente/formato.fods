p>42</text:p></table:table-cell></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>fecha</text:p></table:table-cell><table:table-cell office:value-type="date" office:date-value="2026-10-25" table:style-name="fecha"><text:p>2026-10-25</text:p></table:table-cell></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>negrita</text:p></table:table-cell><table:table-cell office:value-type="string" table:style-name="negrita"><text:p>negrita</text:p></table:table-cell></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>cursiva</text:p></table:table-cell><table:table-cell office:value-type="string" table:style-name="cursiva"><text:p>cursiva</text:p></table:table-cell></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>subrayado</text:p></table:table-cell><table:table-cell office:value-type="string" table:style-name="subrayado"><text:p>subrayado</text:p></table:table-cell></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>color</text:p></table:table-cell><table:table-cell office:value-type="string" table:style-name="rojo"><text:p>rojo</text:p></table:table-cell></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>fondo</text:p></table:table-cell><table:table-cell office:value-type="string" table:style-name="fondo"><text:p>fondo amarillo</text:p></table:table-cell></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>bordes</text:p></table:table-cell><table:table-cell office:value-type="string" table:style-name="bordes"><text:p>con bordes</text:p></table:table-cell></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>fuente y tamaño</text:p></table:table-cell><table:table-cell office:value-type="string" table:style-name="grande"><text:p>Liberation Serif 16</text:p></table:table-cell></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>a la derecha</text:p></table:table-cell><table:table-cell office:value-type="string" table:style-name="derecha"><text:p>derecha</text:p></table:table-cell></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>centrado</text:p></table:table-cell><table:table-cell office:value-type="string" table:style-name="centro"><text:p>centro</text:p></table:table-cell></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>ajustar texto</text:p></table:table-cell><table:table-cell office:value-type="string" table:style-name="ajuste"><text:p>un texto largo que no cabe en el ancho de la columna y baja de línea</text:p></table:table-cell></table:table-row><table:table-row table:number-rows-repeated="2"><table:table-cell/></table:table-row><table:table-row table:style-name="fila_alta"><table:table-cell office:value-type="string"><text:p>fila alta</text:p></table:table-cell></table:table-row><table:table-row table:visibility="collapse"><table:table-cell office:value-type="string"><text:p>fila oculta</text:p></table:table-cell></table:table-row><table:table-row><table:table-cell office:value-type="string" table:number-rows-spanned="2" table:number-columns-spanned="3"><text:p>combinada 2x3</text:p></table:table-cell><table:covered-table-cell table:number-columns-repeated="2"/></table:table-row><table:table-row><table:covered-table-cell table:number-columns-repeated="3"/></table:table-row></table:table></office:spreadsheet></office:body></office:document>
